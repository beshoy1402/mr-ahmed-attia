# Public Firebase Web App configuration.
# These values identify the Firebase web app; they are not admin credentials.
# Never place service-account JSON, private keys, payment secrets, or AI API keys here.
# Set real values in Vercel/Firebase project settings, not in committed files.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secrets must use the hosting provider's encrypted environment variables.
# Do not prefix secrets with NEXT_PUBLIC_.
